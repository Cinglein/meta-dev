<plist version="1.0">
<dict>
	<key>Label</key>
	<string>meta.heartbeat.work.a&amp;b</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/meta</string>
		<string>heartbeat</string>
		<string>tick</string>
